# Copy this file to fetch_bridge/.env, then edit it locally. Never share the token.
#
# BRIDGE_TOKEN is a bearer credential: anything that has it (plus the tunnel URL)
# can run commands on this computer, subject to local approval. Generate a new one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If you leave it blank the server generates a fresh token on every start and
# prints it, which also means every restart invalidates the URL you shared.
BRIDGE_TOKEN=

# Every file path is resolved inside this directory. Use an absolute path.
# Example: C:\Users\You\MyProject
BRIDGE_CWD=

# Optional settings (defaults shown):
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8765
# BRIDGE_TIMEOUT_SECONDS=60
# BRIDGE_WAIT_SECONDS=15
# BRIDGE_RATE_LIMIT=120
# BRIDGE_REQUIRE_NONCE=0
# BRIDGE_STATE_DIR=
# BRIDGE_MCP_CONFIG=C:\path\to\mcp-config.json
