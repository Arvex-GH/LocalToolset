# Written and maintained by start.cmd / launch.py; you can also edit it by hand.
# Never share the token. Delete this file to be issued a new one.

# BRIDGE_TOKEN is a bearer credential: anything that has it (plus the tunnel URL)
# can run commands on this computer. Make it 16-200 characters of A-Z a-z 0-9 . _ ~ -
# Anything else (spaces, ?, #, &, /, %, quotes, non-ASCII) is refused at startup,
# because the token travels in the URL path. Leave it alone to keep it; replace it
# with 32 random bytes by double-clicking rotate_token.cmd (or ./rotate_token.sh).
BRIDGE_TOKEN=

# Working directory for read/write/edit/mkdir/ls. Unset means the root of the
# drive this toolset lives on (C:\ on Windows). Set it to confine file access
# to one project, e.g. C:\Users\You\Documents\Unreal Projects\MyProject
BRIDGE_CWD=

# Optional settings (defaults shown):
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8765
# BRIDGE_TIMEOUT_SECONDS=60
# BRIDGE_WAIT_SECONDS=15
# BRIDGE_RATE_LIMIT=120
# BRIDGE_REQUIRE_NONCE=0
# BRIDGE_STATE_DIR=
# BRIDGE_MCP_CONFIG=C:\path\to\mcp-config.json
